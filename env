#--------------------------------------------------------------------
# PERTUKANGAN - Environment Configuration
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# Sesuaikan dengan cara menjalankan: 'php spark serve' memakai localhost,
# Laragon auto-vhost memakai http://pertukangan.test/
app.baseURL = 'http://localhost:8080/'
app.indexPage = ''

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = pertukangan
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# MAXCHAT API
#--------------------------------------------------------------------

# Base URL & token dikelola per akun lewat menu "Akun MaxChat" (tabel
# maxchat_accounts). Dua nilai di bawah hanya dipakai SEKALI oleh migrasi untuk
# membuat akun pertama; biarkan ISI_TOKEN_DISINI bila akun akan diisi lewat menu.
maxchat.baseURL = 'https://core.maxchat.id/diskominfo/api'
maxchat.token = 'ISI_TOKEN_DISINI'

# Timeout request (detik)
maxchat.timeout = 20

# true  = mode uji coba, pesan TIDAK benar-benar dikirim (hanya dicatat di log)
# false = pesan benar-benar dikirim ke MaxChat
maxchat.dryRun = true

# Kode negara default untuk normalisasi nomor (08xx -> 628xx)
maxchat.countryCode = '62'

# Zona waktu untuk tampilan tanggal & log
app.appTimezone = 'Asia/Jakarta'
